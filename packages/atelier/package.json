  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "happy-dom": "^15.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.13"
