/** Real local service acceptance. Run with Node 25 from organism; requires dedicated Rift. */
import {chromium,expect,type Page} from 'playwright/test'
import {mkdir,writeFile} from 'node:fs/promises'
const base=process.env.IDE_ORIGIN??'http://127.0.0.1:5190'
const graph=process.env.IDE_GRAPH??'shrubbery-development-20260919'
const evidence=process.env.IDE_EVIDENCE??'/tmp/shrubbery-ide-browser'
const marker=`IDE_BROWSER_COLLAB_${Date.now()}`
await mkdir(evidence,{recursive:true})
const browser=await chromium.launch({headless:true,channel:'chrome'})
const contexts=await Promise.all([browser.newContext({viewport:{width:1500,height:1050}}),browser.newContext({viewport:{width:1500,height:1050}})])
const [a,b]=await Promise.all(contexts.map(context=>context.newPage()))
const errors:string[]=[];for(const page of [a,b])page.on('pageerror',error=>errors.push(error.message))
const route=`${base}/choreograph?graphId=${graph}&screen=development&development=1`
async function state(page:Page){return page.locator('wf-development-ide').evaluate((element:any)=>({selectedTaskId:element.state.ide.selectedTaskId,log:element.state.ide.log,tasks:element.state.ide.tasks}))}
async function open(page:Page,path:string,query=path){
  await page.getByRole('button',{name:'Quick open ⌘P'}).focus()
  await page.keyboard.press('Control+p')
  await page.getByRole('textbox',{name:'Quick open file'}).fill(query)
  await page.locator('.quick .result').filter({hasText:path}).first().click({timeout:30000})
  await expect(page.locator('sh-development-code-editor').last().locator('.cm-content')).toHaveAttribute('contenteditable','true',{timeout:30000})
}
async function source(page:Page){return page.locator('sh-development-code-editor').first().evaluate((element:any)=>element.editorView.state.doc.toString())}
try{
  await Promise.all([a.goto(route),b.goto(route)])
  await Promise.all([a.locator('[data-file-path="README.md"]').waitFor({timeout:60000}),b.locator('[data-file-path="README.md"]').waitFor({timeout:60000})])
  await open(a,'README.md');await open(b,'README.md')
  const original=await source(a)
  await a.locator('sh-development-code-editor').evaluate((element:any)=>{const view=element.editorView;view.dispatch({selection:{anchor:view.state.doc.length}});view.focus()})
  await a.keyboard.insertText(`\n<!-- ${marker} -->\n`)
  await expect.poll(()=>source(b),{timeout:20000}).toContain(marker)
  await expect.poll(async()=>b.locator('wf-development-ide').evaluate((element:any)=>element.state.ide.presence.filter((peer:any)=>peer.path==='README.md').length),{timeout:15000}).toBeGreaterThan(1)
  console.log('Shared README visible in second context',marker)
  await a.getByRole('button',{name:'Split editor',exact:true}).click()
  await expect(a.locator('wf-development-ide').locator('.editor-pane')).toHaveCount(2)
  await a.locator('wf-development-ide').locator('.editor-pane').nth(1).click({position:{x:20,y:100}})
  await open(a,'packages/components/src/mn-loading.ts')
  await expect(a.locator('sh-development-code-editor')).toHaveCount(2)
  await a.screenshot({path:`${evidence}/shared-split.png`,fullPage:true})
  await a.getByRole('button',{name:'Single editor',exact:true}).click()
  await a.getByRole('button',{name:'Search',exact:true}).click()
  await a.getByRole('textbox',{name:'Search workspace'}).fill('statusLabel')
  await a.locator('.panel-toolbar').getByRole('button',{name:'Search',exact:true}).click()
  await expect.poll(async()=>a.locator('wf-development-ide').evaluate((element:any)=>element.state.ide.search.matches.length),{timeout:30000}).toBeGreaterThan(0)
  await a.getByRole('button',{name:'Terminal & tasks',exact:true}).click()
  await a.getByRole('textbox',{name:'Task or terminal command'}).fill(`printf "browser-task-start-${marker}\\n"; sleep 10; printf "browser-task-finished\\n"`)
  await a.getByRole('button',{name:'Run',exact:true}).click()
  await expect.poll(async()=>(await state(a)).selectedTaskId,{timeout:60000}).toBeTruthy()
  const taskId=(await state(a)).selectedTaskId
  await expect(a.getByLabel('Task output')).toContainText('browser-task-start',{timeout:20000})
  await a.close()
  await b.getByRole('button',{name:'Terminal & tasks',exact:true}).click()
  await b.locator('.task-list button').filter({hasText:`browser-task-start-${marker}`}).first().click({timeout:15000})
  await expect(b.getByLabel('Task output')).toContainText('browser-task-finished',{timeout:30000})
  console.log('Task retained after initiating browser closed',taskId)
  await b.screenshot({path:`${evidence}/task-continuation.png`,fullPage:true})
  await b.getByRole('button',{name:'Shell',exact:true}).click()
  await b.locator('wf-development-terminal textarea').waitFor({timeout:60000})
  await b.locator('.stdin input').fill('printf "interactive-pty-received\\n"')
  await b.getByRole('button',{name:'Send',exact:true}).click()
  await expect.poll(async()=>(await state(b)).log,{timeout:15000}).toMatch(/\r?\ninteractive-pty-received\r?\n/)
  await b.locator('wf-development-terminal textarea').focus()
  await b.keyboard.type('printf "raw-pty-input\\n"');await b.keyboard.press('Enter')
  await expect.poll(async()=>(await state(b)).log,{timeout:15000}).toMatch(/\r?\nraw-pty-input\r?\n/)
  await b.screenshot({path:`${evidence}/interactive-terminal.png`,fullPage:true})
  await expect(b.locator('wf-development-ide [role="alert"]')).toHaveCount(0)
  await b.getByRole('button',{name:'Cancel process',exact:true}).click()
  await open(b,'packages/components/src/mn-loading.ts','mnldts')
  await expect.poll(async()=>b.locator('wf-development-ide').evaluate((element:any)=>element.state.ide.languageStatus),{timeout:30000}).toContain('generation')
  await b.locator('sh-development-code-editor').evaluate((element:any)=>{const view=element.editorView,source=view.state.doc.toString();view.dispatch({selection:{anchor:source.indexOf('this.')+5}});view.focus()})
  await b.keyboard.press('Control+Space');await expect(b.locator('.cm-tooltip-autocomplete')).toBeVisible({timeout:20000})
  await b.screenshot({path:`${evidence}/typescript-completion.png`,fullPage:true});await b.keyboard.press('Escape')
  await b.getByRole('button',{name:'Preview',exact:true}).click()
  await b.getByRole('button',{name:'Start Rift preview',exact:true}).click()
  await expect(b.getByRole('textbox',{name:'Preview path'})).toBeVisible({timeout:10000})
  await b.getByRole('textbox',{name:'Preview path'}).fill('/development-loading-preview.html');await b.getByRole('textbox',{name:'Preview path'}).press('Tab')
  await expect(b.frameLocator('iframe[title="Rift application preview"]').locator('mn-loading').first()).toBeVisible({timeout:45000})
  await expect(b.locator('wf-development-ide [role="alert"]')).toHaveCount(0)
  await b.frameLocator('iframe[title="Rift application preview"]').locator('mn-loading').first().scrollIntoViewIfNeeded()
  await b.screenshot({path:`${evidence}/preview-workbench.png`,fullPage:true})
  await b.getByRole('button',{name:'Team & environment',exact:true}).click()
  await b.screenshot({path:`${evidence}/team-observations.png`,fullPage:true})
  await b.getByRole('combobox',{name:'Working Rift'}).selectOption('shrubbery-beta')
  await expect.poll(async()=>b.locator('wf-development-ide').evaluate((element:any)=>element.state.selectedRiftId)).toBe('shrubbery-beta')
  await open(b,'README.md');expect(await source(b)).not.toContain('IDE_BROWSER_COLLAB_')
  console.log('Beta unchanged; actual preview visible; no page errors',errors)
  await expect(b.locator('wf-development-ide [role="alert"]')).toHaveCount(0)
  await b.getByRole('combobox',{name:'Working Rift'}).selectOption('shrubbery-alpha');await open(b,'README.md')
  const inserted=`\n<!-- ${marker} -->\n`
  await b.locator('sh-development-code-editor').evaluate((element:any,inserted)=>{const view=element.editorView,from=view.state.doc.toString().indexOf(inserted);if(from>=0)view.dispatch({changes:{from,to:from+inserted.length,insert:''}})},inserted)
  await expect.poll(()=>source(b)).not.toContain(marker)
  const created=`docs/ide-ui-${Date.now()}.txt`,renamed=created.replace('.txt','-renamed.txt')
  await b.getByRole('button',{name:'New file',exact:true}).click()
  await b.getByRole('textbox',{name:'File path',exact:true}).fill(created)
  await b.getByRole('textbox',{name:'Initial contents',exact:true}).fill('Browser file operation acceptance\n')
  await b.getByRole('dialog',{name:'Create file',exact:true}).getByRole('button',{name:'Create file',exact:true}).click()
  await expect.poll(()=>source(b),{timeout:60000}).toBe('Browser file operation acceptance\n')
  await b.getByRole('button',{name:'Rename file…',exact:true}).click()
  await b.getByRole('textbox',{name:'File path',exact:true}).fill(renamed)
  await b.getByRole('dialog',{name:'Rename file',exact:true}).getByRole('button',{name:'Rename file',exact:true}).click()
  await expect(b.locator('wf-development-ide .breadcrumbs')).toContainText(renamed.split('/').at(-1)!,{timeout:60000})
  await b.getByRole('button',{name:'Delete…',exact:true}).click()
  await b.getByRole('dialog',{name:'Delete file',exact:true}).getByRole('button',{name:'Delete file',exact:true}).click()
  await expect(b.locator('wf-development-ide .breadcrumbs')).not.toContainText(renamed.split('/').at(-1)!,{timeout:20000})
  await expect(b.locator('wf-development-ide [role="alert"]')).toHaveCount(0)
  if(errors.length)throw new Error(errors.join('\n'))
  await writeFile(`${evidence}/result.json`,JSON.stringify({ok:true,marker,taskId,errors,sourceLength:original.length,graph,base,checks:['quick-open','lazy-tree','two-browser-shared-source','awareness','tabs','split','workspace-search','task-close-and-resume','PTY-stdin-resize','automatic-diagnostics','keyboard-completion','separate-preview','Rift-isolation','create-rename-delete']},null,2))
}catch(error){await writeFile(`${evidence}/failure.txt`,String(error));for(const [index,page]of [a,b].entries())if(!page.isClosed())await page.screenshot({path:`${evidence}/failure-${index}.png`,fullPage:true});throw error}
finally{await browser.close()}
