{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia-labs.com/schemas/shrubbery-acceptance-defect-v1.json",
  "title": "Shrubbery acceptance defect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defectId",
    "title",
    "severity",
    "status",
    "capabilityIds",
    "journeyId",
    "stepId",
    "mode",
    "role",
    "oracleBehavior",
    "expected",
    "actual",
    "reproduction",
    "evidence",
    "firstSeenTargetCommit",
    "lastSeenTargetCommit",
    "firstSeenAt",
    "lastSeenAt",
    "rerunCommand"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "defectId": {"type": "string", "pattern": "^ACC-DEF-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "status": {"enum": ["open", "triaged", "in-progress", "fixed-awaiting-rerun", "closed", "accepted-risk"]},
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ACC-CAP-[A-Z0-9]+-[0-9]{3}$"}
    },
    "journeyId": {"type": "string", "pattern": "^ACC-J[0-9]{3}$"},
    "stepId": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "oracleBehavior": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "actual": {"type": "string", "minLength": 1},
    "reproduction": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "suspectedContract": {"type": ["string", "null"]},
    "owner": {"type": ["string", "null"]},
    "workaround": {"type": ["string", "null"]},
    "firstSeenTargetCommit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "lastSeenTargetCommit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "firstSeenAt": {"type": "string", "format": "date-time"},
    "lastSeenAt": {"type": "string", "format": "date-time"},
    "rerunCommand": {"type": "string", "minLength": 1}
  }
}
