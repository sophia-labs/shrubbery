# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:f32b81066cde10a75dbac96646099533316d94bac4150c55da1636e1f0ffdc46
ARG RUNTIME_IMAGE=gcr.io/distroless/nodejs22-debian12:nonroot@sha256:afa48e2ae1100924bfb069244f4ef70c0f9c061654c669da6b7faa7881c1ec7f
FROM ${NODE_IMAGE} AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /src
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @shrubbery/planter build:pool

FROM ${RUNTIME_IMAGE}
ARG SOURCE_REVISION
LABEL dev.sophia.source-revision="${SOURCE_REVISION}"
ENV NODE_ENV=production
ENV PORT=8793
WORKDIR /app
COPY --from=build --chown=65532:65532 /src/apps/planter/dist-pool/ /app/
USER 65532:65532
EXPOSE 8793
CMD ["/app/planter-pool.mjs"]
