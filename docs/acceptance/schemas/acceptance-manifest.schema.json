{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia-labs.com/schemas/shrubbery-acceptance-manifest-v1.json",
  "title": "Shrubbery Garden fidelity acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "programId",
    "title",
    "oracle",
    "target",
    "verdicts",
    "tiers",
    "modes",
    "roles",
    "requiredDomains",
    "capabilities",
    "journeys",
    "coverageRules"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "programId": {"const": "shrubbery-garden-fidelity"},
    "title": {"type": "string", "minLength": 1},
    "oracle": {
      "type": "object",
      "required": ["repository", "commit", "entrypoints", "supplementalHarness"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "entrypoints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "supplementalHarness": {"type": "object"}
      }
    },
    "target": {"type": "object"},
    "verdicts": {
      "type": "array",
      "const": ["PASS", "FAIL", "BLOCKED", "NOT-APPLICABLE"]
    },
    "tiers": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiredDomains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "journeys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/journey"}
    },
    "coverageRules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "title", "oracle", "target", "contracts", "tier", "modes", "roles", "stateful", "journeys"],
      "properties": {
        "id": {"type": "string", "pattern": "^ACC-CAP-[A-Z0-9]+-[0-9]{3}$"},
        "domain": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "signals"],
          "properties": {
            "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "signals": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "surfaces", "support"],
          "properties": {
            "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "support": {"type": "string", "minLength": 1}
          }
        },
        "contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tier": {"type": "string", "pattern": "^T[0-6]-"},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "stateful": {"type": "boolean"},
        "blocker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {"kind": {"type": "string"}, "summary": {"type": "string"}}
        },
        "journeys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ACC-J[0-9]{3}$"}}
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "title", "tier", "capabilities", "modes", "roles", "fixture", "pairwiseDimensions", "steps", "command"],
      "properties": {
        "id": {"type": "string", "pattern": "^ACC-J[0-9]{3}$"},
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "tier": {"type": "string", "pattern": "^T[0-6]-"},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ACC-CAP-[A-Z0-9]+-[0-9]{3}$"}},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fixture": {"type": "string", "minLength": 1},
        "pairwiseDimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action", "expected", "evidence"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "expected": {"type": "string", "minLength": 1},
              "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "command": {"type": "string", "minLength": 1}
      }
    }
  }
}
