{
  "name": "@shrubbery/nucleus",
  "version": "0.0.0",
  "description": "Pure RDF->UI interpreter + contract for the Shrubbery component library",
  "type": "module",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./kinds": "./src/kinds/index.ts",
    "./value-faces": "./src/value-faces/index.ts",
    "./object-faces": "./src/object-faces/index.ts",
    "./workspace": "./src/workspace/index.ts",
    "./files-canvas": "./src/workspace/files-canvas/index.ts",
    "./board-layout": "./src/workspace/board-layout/index.ts",
    "./layout": "./src/layout/index.ts",
    "./component-library": "./src/workspace/component-library.ts",
    "./component-library/manifest": "./component-library/manifest.ts",
    "./seed/garden-default.ux.nt": "./src/workspace/__generated__/garden-default.ux.nt",
    "./web-crypto": "./src/web-crypto.ts",
    "./roving-toolbar": "./src/roving-toolbar.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "generate:ux-seed": "tsx scripts/generate-garden-default.mts"
  },
  "dependencies": {
    "@excalidraw/common": "0.18.0-4ce38fb",
    "@excalidraw/element": "0.18.0-4ce38fb",
    "@excalidraw/math": "0.18.0-4ce38fb",
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "@shrubbery/tokens": "workspace:*",
    "@types/node": "^22.7.4",
    "happy-dom": "^15.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.13"
  }
}
