{
  "name": "@shrubbery/hoja-app",
  "version": "0.0.0",
  "description": "hoja — a shockingly minimalist notes app over .sd seed files. Looks like paper; plugs into Sophia.",
  "type": "module",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloud": "HOJA_BASE_PATH=/hoja/ vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:browser": "node --import tsx scripts/hoja-browser-harness.mts",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@shrubbery/hoja": "workspace:*",
    "@shrubbery/source": "workspace:*",
    "@shrubbery/tokens": "workspace:*",
    "lit": "^3.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "happy-dom": "^15.0.0",
    "playwright": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.8",
    "vitest": "^3.2.6"
  }
}
