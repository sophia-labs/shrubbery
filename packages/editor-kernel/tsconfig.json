{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode — matches nucleus / runtime / garden frontend so the copied
       .js specifiers (which resolve to .ts siblings) typecheck unchanged. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* NO experimentalDecorators — this is a PURE TipTap/ProseMirror kernel; it
       imports no Lit and defines no decorated classes (unlike @shrubbery/runtime
       which hosts the live <sh-editor-host> Class-B Lit element). */

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
