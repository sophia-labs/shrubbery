{
  "name": "@shrubbery/organism",
  "version": "0.0.0",
  "description": "The ORGANISM playground — a plain Vite app that boots the REAL render host (@shrubbery/runtime) + chrome components (@shrubbery/components) against REAL RDF. No backend, no mock.",
  "type": "module",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "private": true,
  "exports": {
    "./cell/loopback-mcp": "./src/cell/loopback-mcp.ts",
    "./cell/app-routes": "./src/cell/app-routes.ts",
    "./cell/emporium-client": "./src/cell/emporium-client.ts",
    "./cell/emporium-store": "./src/cell/emporium-store.ts",
    "./cell/public-shell": "./src/cell/public-shell.ts",
    "./cell/spawn-gardend": "./src/cell/spawn-gardend.ts",
    "./cell/vocab-views": "./src/cell/vocab-views.ts",
    "./cell/loopback-crdt-backend": "./src/cell/loopback-crdt-backend.ts",
    "./cell/gateway-transport": "./src/cell/gateway-transport.ts",
    "./cell/gateway-crdt-backend": "./src/cell/gateway-crdt-backend.ts",
    "./cell/hosted-gateway-contract": "./src/cell/hosted-gateway-contract.ts",
    "./cell/cognito-auth-session": "./src/cell/cognito-auth-session.ts",
    "./scripts/seele-compile-route": "./scripts/seele-compile-route.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:cell-proxy": "vitest run tests/vite-cell-proxy.integration.test.ts",
    "gardend:dev": "tsx scripts/gardend-dev.mts",
    "gardend:live": "tsx scripts/gardend-liveread.live.mts",
    "test:access-browser": "node --import tsx scripts/hosted-access-browser-harness.mts",
    "test:art-direction-browser": "node --import tsx scripts/art-direction-browser-harness.mts",
    "test:browser": "node --import tsx scripts/browser-harness.mts && node --import tsx scripts/settings-browser-harness.mts && node --import tsx scripts/editor-material-browser-harness.mts && node --import tsx scripts/art-direction-browser-harness.mts",
    "test:browser-verified": "node --import tsx scripts/center-panes-browser-harness.mts && node --import tsx scripts/file-pane-browser-harness.mts && node --import tsx scripts/mobile-parity-browser-harness.mts && node --import tsx scripts/pane-parity-browser-harness.mts && node --import tsx scripts/wires-panel-browser-harness.mts && node --import tsx scripts/workspace-selector-browser-harness.mts",
    "test:center-panes-browser": "node --import tsx scripts/center-panes-browser-harness.mts",
    "test:center-panes-gardend-browser": "node --import tsx scripts/center-panes-gardend-browser.mts",
    "test:daily-note-browser": "node --import tsx scripts/daily-note-browser-harness.mts",
    "test:document-activation-browser": "node --import tsx scripts/document-activation-gardend-browser.mts",
    "test:offline-sync-browser": "node --import tsx scripts/offline-sync-later-gardend-browser.mts",
    "test:offline-sync-webkit": "SHRUBBERY_BROWSER_ENGINE=webkit node --import tsx scripts/offline-sync-later-gardend-browser.mts",
    "test:source-sync-truth": "node --import tsx scripts/source-sync-distributed-truth-gardend.mts",
    "test:source-sync-chaos": "node --import tsx scripts/source-sync-chaos-gardend.mts",
    "test:source-mirror-idb-chaos": "node --import tsx scripts/source-mirror-indexeddb-chaos-browser.mts",
    "audit:offline-meaningful-objects": "node --import tsx scripts/offline-meaningful-objects-gardend.mts",
    "audit:offline-interesting-behavior": "node --import tsx scripts/offline-interesting-behavior-gardend.mts",
    "audit:offline-distributed-truth": "node --import tsx scripts/offline-distributed-truth-harness.mts",
    "verify:offline-distributed-truth": "node --import tsx scripts/offline-distributed-truth-harness.mts --require-data-plane-go",
    "verify:unqualified-offline": "node --import tsx scripts/offline-distributed-truth-harness.mts --require-go",
    "test:editor-material-browser": "node --import tsx scripts/editor-material-browser-harness.mts",
    "test:file-pane-browser": "node --import tsx scripts/file-pane-browser-harness.mts",
    "test:fid004-browser": "node --import tsx scripts/fid004-cold-projection-browser.mts",
    "test:graph-browser": "node --import tsx scripts/graph-browser-harness.mts",
    "test:keyboard-browser": "node --import tsx scripts/keyboard-parity-browser-harness.mts",
    "test:layout-workbench-browser": "node --import tsx scripts/layout-workbench-gardend-browser.mts",
    "test:card-object-browser": "node --import tsx scripts/card-object-browser-harness.mts",
    "test:bottom-bar-mirror-badges-browser": "node --import tsx scripts/bottom-bar-mirror-badges-browser.mts",
    "test:contested-surface-gardend": "node --import tsx scripts/contested-surface-gardend.mts",
    "test:contested-query-service-browser": "node --import tsx scripts/contested-query-service-browser.mts",
    "test:contested-resolution-browser": "node --import tsx scripts/contested-resolution-browser.mts",
    "test:graph-fence-parked-browser": "node --import tsx scripts/graph-fence-parked-browser.mts",
    "test:graph-fence-parked-webkit": "SHRUBBERY_BROWSER_ENGINE=webkit node --import tsx scripts/graph-fence-parked-browser.mts",
    "test:parked-work-reapply-browser": "node --import tsx scripts/parked-work-reapply-browser.mts",
    "test:workspace-lifetime-reapply-shell-browser": "node --import tsx scripts/workspace-lifetime-reapply-shell-browser.mts",
    "test:observatory-dashboard-browser": "node --import tsx scripts/observatory-dashboard-gardend-browser.mts",
    "test:prime-notebook-cloud2-browser": "node --import tsx scripts/prime-notebook-cloud2-browser.mts",
    "test:prime-notebook-arc-f4-browser": "node --import tsx scripts/prime-notebook-arc-f4-browser.mts",
    "test:prime-notebook-arc-f5-local-browser": "node --import tsx scripts/prime-notebook-arc-f5-local-browser.mts",
    "test:prime-notebook-config-refresh-browser": "node --import tsx scripts/prime-notebook-config-refresh-browser.mts",
    "test:sophia-cluster-agent-studio-browser": "node --import tsx scripts/sophia-cluster-agent-studio-browser.mts",
    "test:mobile-browser": "node --import tsx scripts/mobile-parity-browser-harness.mts",
    "test:mobile-surface-keyboard-browser": "node --import tsx scripts/mobile-surface-keyboard-browser.mts",
    "test:pane-browser": "node --import tsx scripts/pane-parity-browser-harness.mts",
    "test:presence-browser": "node --import tsx scripts/presence-browser-harness.mts",
    "test:settings-browser": "node --import tsx scripts/settings-browser-harness.mts",
    "test:wires-browser": "node --import tsx scripts/wires-panel-browser-harness.mts",
    "test:workspace-selector-browser": "node --import tsx scripts/workspace-selector-browser-harness.mts"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "@shrubbery/atelier-vtuber": "workspace:*",
    "@shrubbery/components": "workspace:*",
    "@shrubbery/domain-kit": "workspace:*",
    "@shrubbery/hoja": "workspace:*",
    "@shrubbery/nucleus": "workspace:*",
    "@shrubbery/render": "workspace:*",
    "@shrubbery/runtime": "workspace:*",
    "@shrubbery/site": "workspace:*",
    "@shrubbery/source": "workspace:*",
    "@shrubbery/tokens": "workspace:*",
    "@tauri-apps/api": "^2.10.0",
    "fflate": "^0.8.2",
    "lit": "^3.1.4",
    "oxigraph": "0.5.9",
    "pdfjs-dist": "^5.7.284",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pngjs": "6.0.5",
    "@types/ws": "^8.5.12",
    "happy-dom": "^15.0.0",
    "playwright": "^1.48.0",
    "pngjs": "7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.8",
    "vitest": "^3.2.6",
    "ws": "^8.18.0"
  }
}
