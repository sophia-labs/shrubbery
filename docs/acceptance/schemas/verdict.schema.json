{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia-labs.com/schemas/shrubbery-acceptance-verdict-v1.json",
  "title": "Shrubbery acceptance verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "capabilityId",
    "journeyId",
    "stepId",
    "verdict",
    "mode",
    "role",
    "expected",
    "observed",
    "rationale",
    "evidence",
    "startedAt",
    "finishedAt",
    "targetCommit",
    "rerunCommand"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "capabilityId": {"type": "string", "pattern": "^ACC-CAP-[A-Z0-9]+-[0-9]{3}$"},
    "journeyId": {"type": "string", "pattern": "^ACC-J[0-9]{3}$"},
    "stepId": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT-APPLICABLE"]},
    "mode": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "observed": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "blocker": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "summary", "owner"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "defectIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ACC-DEF-[0-9]{4,}$"}
    },
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "targetCommit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "gardendCommit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "rerunCommand": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "BLOCKED"}}},
      "then": {"required": ["blocker"]}
    },
    {
      "if": {"properties": {"verdict": {"const": "FAIL"}}},
      "then": {"required": ["defectIds"]}
    }
  ]
}
